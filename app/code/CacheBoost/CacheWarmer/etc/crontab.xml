<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Processes the cacheboost.warm queue when the queue consumer is not run
             (see Model\Queue\ProcessingStrategy). Returns immediately otherwise. -->
        <job name="cacheboost_warm_drain_queue"
             instance="CacheBoost\CacheWarmer\Cron\DrainWarmQueue"
             method="execute">
            <schedule>* * * * *</schedule>
        </job>

        <!-- Cache configuration snapshot for the cache diagnostics (Model\Environment\EnvironmentReporter):
             sends when scheduled or hourly, only when it changed. -->
        <job name="cacheboost_environment_snapshot"
             instance="CacheBoost\CacheWarmer\Cron\ReportEnvironment"
             method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
    </group>
</config>

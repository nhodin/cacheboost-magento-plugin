<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <!-- Full cache flush: "Flush Magento Cache" button in admin AND `bin/magento cache:flush`
         (Magento dispatches this event from both). Declared globally so it also fires in CLI. -->
    <event name="adminhtml_cache_flush_all">
        <observer name="cacheboost_flush_all"
                  instance="CacheBoost\CacheWarmer\Observer\FlushAll"/>
    </event>

    <!-- Granular tag-based invalidation (product/category/CMS save, reindex, etc.) -->
    <event name="clean_cache_by_tags">
        <observer name="cacheboost_flush_by_tags"
                  instance="CacheBoost\CacheWarmer\Observer\FlushByTags"/>
    </event>

    <!-- Legacy post-reindex event: no longer dispatched by Magento 2.4.6+ (reindexes go through
         clean_cache_by_tags), kept for third-party code that still fires it. -->
    <event name="clean_cache_after_reindex">
        <observer name="cacheboost_flush_reindex"
                  instance="CacheBoost\CacheWarmer\Observer\FlushAll"/>
    </event>

    <!-- Flush the URL buffer once, just before the response is sent -->
    <event name="controller_front_send_response_before">
        <observer name="cacheboost_send_buffered_urls"
                  instance="CacheBoost\CacheWarmer\Observer\SendBufferedUrls"/>
    </event>

</config>

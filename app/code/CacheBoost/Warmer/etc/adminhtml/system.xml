<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="cacheboost" translate="label" sortOrder="300">
            <label>CacheBoost</label>
        </tab>

        <section id="cacheboost" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
            <label>CacheBoost Warmer</label>
            <tab>cacheboost</tab>
            <resource>CacheBoost_Warmer::config</resource>

            <!-- ── General ─────────────────────────────────────────────────── -->
            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>General</label>

                <field id="connect" translate="label" sortOrder="5" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>CacheBoost account</label>
                    <frontend_model>CacheBoost\Warmer\Block\Adminhtml\ConnectPanel</frontend_model>
                </field>

                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enable CacheBoost</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="api_key" translate="label comment" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>API Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment><![CDATA[Filled in automatically by "Connect to CacheBoost". You can also paste a key (format <code>cb_live_…</code>) generated in your <a href="https://app.cache-boost.com/profile" target="_blank" rel="noopener">CacheBoost profile</a>: scopes <strong>boosts:read</strong>, <strong>boosts:write</strong>, <strong>runs:read</strong>, plus <strong>sites:read</strong> to find the site and <strong>sites:write</strong> to validate the domain and share the cache configuration.]]></comment>
                </field>

                <field id="site_id" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Site ID</label>
                    <comment>Filled in automatically by "Connect to CacheBoost" and "Test connection" (the site whose domain is the default store view's). Numeric identifier of the site in CacheBoost.</comment>
                    <validate>validate-digits</validate>
                </field>

                <field id="region" translate="label comment" type="multiselect" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Warm Regions</label>
                    <source_model>CacheBoost\Warmer\Model\Config\Source\Region</source_model>
                    <can_be_empty>1</can_be_empty>
                    <comment>Regions your cache is warmed from. The list comes from your CacheBoost account: click "Test connection" to refresh it. Leave all unselected to use every available region.</comment>
                </field>

                <field id="mode" translate="label comment" type="select" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Warm Mode</label>
                    <source_model>CacheBoost\Warmer\Model\Config\Source\WarmMode</source_model>
                    <comment><![CDATA[<strong>Smart</strong>: resolves Magento tags to URLs and triggers a targeted warm (recommended). <strong>Full Only</strong>: always triggers the full scheduled Boost.]]></comment>
                </field>

            </group>

            <!-- ── Full flush (scheduled boost) ──────────────────────────── -->
            <group id="flush_all" translate="label comment" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Full Flush — Scheduled Boost</label>
                <comment><![CDATA[Used on full cache flush events (Flush All Cache, Flush Storage, Reindex). These events provide no URL list: CacheBoost must warm from an existing Boost with a sitemap or CSV. <strong>Prerequisite:</strong> create a "sitemap" or "csv" Boost in the CacheBoost app, note its ID, and enter it below. The API key must have the <strong>boosts:write</strong> scope. If no Boost ID is set, full flush events are silently skipped (scheduled boosts cover this case).]]></comment>

                <field id="boost_id" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Boost ID (full flush)</label>
                    <comment><![CDATA[Numeric ID of the CacheBoost Boost to trigger (e.g. 7). Leave empty to disable. Must be a <strong>sitemap</strong> or <strong>csv</strong> Boost — not inline. See the README for setup instructions.]]></comment>
                    <validate>validate-digits-range digits-range-0-999999</validate>
                </field>
            </group>

            <!-- ── Background processing ─────────────────────────────────── -->
            <group id="processing" translate="label comment" sortOrder="22" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Background Processing</label>
                <comment><![CDATA[Warm requests are queued and processed in the background so that no customer or admin request waits on the CacheBoost API. Choose how the queue is processed on this server; the status below shows what is actually happening.]]></comment>

                <field id="mode" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Processing Mode</label>
                    <source_model>CacheBoost\Warmer\Model\Config\Source\ProcessingMode</source_model>
                    <comment><![CDATA[<strong>Auto</strong> fits most servers: it uses the <code>cacheboostWarmConsumer</code> queue consumer when Magento's consumers runner starts it, and the module cron job otherwise (for example when <code>cron_consumers_runner</code> is disabled in <code>app/etc/env.php</code>). Choose <strong>Synchronous</strong> only if Magento cron does not run on this server.]]></comment>
                </field>

                <field id="status" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label></label>
                    <frontend_model>CacheBoost\Warmer\Block\Adminhtml\ProcessingStatus</frontend_model>
                </field>
            </group>

            <!-- ── Cache diagnostics (environment snapshot) ────────────────── -->
            <group id="diagnostics" translate="label comment" sortOrder="24" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Cache Diagnostics</label>
                <comment><![CDATA[CacheBoost's cache diagnostics cannot read your server configuration. The module sends a summary of it when it changes, so the diagnostics can explain cache MISSes (full page cache off, Varnish not used, cache types disabled…).]]></comment>

                <field id="share_environment" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Share the cache configuration with CacheBoost</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>On by default once connected. Turning it off asks CacheBoost to delete what it received.</comment>
                </field>

                <field id="status" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label></label>
                    <frontend_model>CacheBoost\Warmer\Block\Adminhtml\EnvironmentPanel</frontend_model>
                </field>
            </group>

            <!-- ── Tests & Diagnostic ────────────────────────────────────── -->
            <group id="test" translate="label" sortOrder="25" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Tests &amp; Diagnostic</label>

                <field id="test_buttons" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label></label>
                    <frontend_model>CacheBoost\Warmer\Block\Adminhtml\TestButton</frontend_model>
                </field>
            </group>

            <!-- ── Warm history ───────────────────────────────────────────── -->
            <group id="history" translate="label" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Warm History</label>

                <field id="warm_history" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label></label>
                    <frontend_model>CacheBoost\Warmer\Block\Adminhtml\WarmHistory</frontend_model>
                </field>
            </group>

        </section>
    </system>
</config>

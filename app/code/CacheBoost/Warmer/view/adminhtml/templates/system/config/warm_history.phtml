<?php

declare(strict_types=1);

/**
 * "Warm History" panel: table of the most recent inline and full warm runs.
 *
 * @var \CacheBoost\Warmer\Block\Adminhtml\WarmHistory $block
 * @var \Magento\Framework\Escaper $escaper
 */

$statusStyles = [
    'pending' => 'background:#fff8e1;color:#e65100;border:1px solid #ffe082',
    'running' => 'background:#e3f2fd;color:#1565c0;border:1px solid #90caf9',
    'done'    => 'background:#e8f5e9;color:#2e7d32;border:1px solid #a5d6a7',
    'failed'  => 'background:#ffebee;color:#c62828;border:1px solid #ef9a9a',
];
$statusStyleDefault = 'background:#f5f5f5;color:#555;border:1px solid #ddd';

$typeStyles = [
    'full'   => 'background:#ede7f6;color:#4527a0;border:1px solid #b39ddb',
    'inline' => 'background:#e8eaf6;color:#283593;border:1px solid #9fa8da',
];

$runs = $block->isConfigured() ? $block->getRuns() : [];
?>
<?php if (!$block->isConfigured()): ?>
    <p style="color:#888;font-style:italic;margin:8px 0;font-size:13px">
        <?= $escaper->escapeHtml(__('Configure the API Key and Site ID to display warm history.')) ?>
    </p>
<?php elseif (empty($runs)): ?>
    <p style="color:#888;font-style:italic;margin:8px 0;font-size:13px">
        <?= $escaper->escapeHtml(__('No warm runs found for this site.')) ?>
    </p>
<?php else: ?>
    <table style="width:100%;border-collapse:collapse;font-size:13px;margin-top:4px">
        <thead>
            <tr style="background:#f8f8f8;border-bottom:2px solid #ddd;text-align:left">
                <th style="padding:8px 12px;font-weight:600;color:#555"><?= $escaper->escapeHtml(__('Run')) ?></th>
                <th style="padding:8px 12px;font-weight:600;color:#555"><?= $escaper->escapeHtml(__('Status')) ?></th>
                <th style="padding:8px 12px;font-weight:600;color:#555"><?= $escaper->escapeHtml(__('Type')) ?></th>
                <th style="padding:8px 12px;font-weight:600;color:#555"><?= $escaper->escapeHtml(__('Date')) ?></th>
                <th style="padding:8px 12px;font-weight:600;color:#555;text-align:right"><?= $escaper->escapeHtml(__('URLs')) ?></th>
                <th style="padding:8px 12px;font-weight:600;color:#555"><?= $escaper->escapeHtml(__('Region')) ?></th>
                <th style="padding:8px 12px;font-weight:600;color:#555"><?= $escaper->escapeHtml(__('HIT / MISS')) ?></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($runs as $run): ?>
                <?php $statusStyle = $statusStyles[$run['status']] ?? $statusStyleDefault; ?>
                <tr style="border-bottom:1px solid #eee">
                    <td style="padding:7px 12px;font-size:12px">
                        <a href="<?= $escaper->escapeUrl($run['app_run_url']) ?>" target="_blank" rel="noopener"
                           style="color:#1565c0;text-decoration:none;font-weight:600">#<?= (int) $run['id'] ?> ↗</a>
                    </td>
                    <td style="padding:7px 12px">
                        <span style="display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700;<?= $escaper->escapeHtmlAttr($statusStyle) ?>"><?= $escaper->escapeHtml(strtoupper($run['status'])) ?></span>
                    </td>
                    <td style="padding:7px 12px">
                        <span style="display:inline-block;padding:2px 7px;border-radius:10px;font-size:11px;font-weight:600;<?= $escaper->escapeHtmlAttr($typeStyles[$run['type']]) ?>"><?= $escaper->escapeHtml(strtoupper($run['type'])) ?></span>
                    </td>
                    <td style="padding:7px 12px;color:#555"><?= $escaper->escapeHtml($run['date']) ?></td>
                    <td style="padding:7px 12px;text-align:right"><?= $escaper->escapeHtml($run['url_count']) ?></td>
                    <td style="padding:7px 12px;color:#555"><?= $escaper->escapeHtml($run['region']) ?></td>
                    <td style="padding:7px 12px">
                        <?php if ($run['hit'] === null): ?>
                            <span style="color:#aaa">—</span>
                        <?php else: ?>
                            <span style="color:#2e7d32;font-weight:600"><?= (int) $run['hit'] ?> HIT</span>
                            <span style="color:#aaa">/</span>
                            <span style="color:#c62828"><?= (int) $run['miss'] ?> MISS</span>
                            <span style="color:#888;font-size:11px">(<?= $escaper->escapeHtml($run['hit_rate']) ?>)</span>
                        <?php endif; ?>
                    </td>
                </tr>
            <?php endforeach; ?>
        </tbody>
    </table>
<?php endif; ?>
